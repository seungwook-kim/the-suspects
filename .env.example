# 복사해서 .env 로 쓰세요. .env 는 커밋하지 않습니다.
# 비워 두면 가짜 LLM(fake)으로 돌아갑니다. 키를 넣고 config/models.local.yaml에
# 실제 OpenRouter 모델 ID를 적으면 진짜 모델을 씁니다.
OPENROUTER_API_KEY=
# 다른 OpenAI 호환 주소를 쓰려면 config/models.local.yaml의 프로필에 base_url과 api_key_env(키 변수 이름)를 적고,
# 그 이름의 줄을 여기에 하나 더 만든다. 주소마다 다른 요청 값은 extra_body로.
THE_SUSPECTS_MODEL_PROFILE=dev        # dev | prod
THE_SUSPECTS_MODE=dev                 # dev(원문 로그 남김) | prod(원문 미저장)

# Langfuse (선택)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# 인물 초상화 (Cloudflare Workers AI 무료 할당량). 비워 두면 화면이 그림 대신 SVG 얼굴을 씁니다.
# 계정 ID: 대시보드 'Workers & Pages' 화면의 Account ID / 토큰: My Profile > API Tokens > Create Token > 'Workers AI' 템플릿
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ─── 선택 설정 (보통 안 건드린다) ────────────────────────────────
# 게임 설정 파일(game.yaml) 경로. 비우면 기본 경로
# GAME_CONFIG_PATH=
# 서버가 받아 줄 웹 주소(쉼표로 여러 개). 기본 http://localhost:5173
# THE_SUSPECTS_CORS=http://localhost:5173
# 1이면 서버 없이 가짜 데이터로 화면만 돌린다 (웹 쪽 변수: apps/web/.env.mock 참고)
# VITE_USE_MOCK=1
