# 복사해서 .env 로 쓰세요. .env 는 커밋하지 않습니다.
# 비워 두면 가짜 LLM(fake)으로 돌아갑니다. 키를 넣고 config/models.local.yaml에
# 실제 OpenRouter 모델 ID를 적으면 진짜 모델을 씁니다.
OPENROUTER_API_KEY=
THE_SUSPECTS_MODEL_PROFILE=dev        # dev | prod
THE_SUSPECTS_MODE=dev                 # dev(원문 로그 남김) | prod(원문 미저장)

# Langfuse (선택)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
